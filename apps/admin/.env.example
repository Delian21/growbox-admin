[TEMPLATE]
# Base URL of the admin API. Unset/empty = mock layer (MSW) once phase 3 lands.
VITE_API_BASE_URL=

# Currency display (apps/admin/src/lib/currency.ts). Amounts are integer minor
# units end-to-end; these two only decide the rendering. Defaults are NGN/en-NG.
# Set KES / en-KE for the Kenyan demo fixtures, GHS / en-GH, etc.
VITE_CURRENCY_CODE=NGN
VITE_LOCALE=en-NG
